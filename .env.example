# Copy to .env.local and fill in your Supabase project values.
# NEVER commit .env.local (it is git-ignored). Service-role key stays server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (server-only — never expose the secret client-side).
# The browser only receives KEY_ID from /api/payments/order to open checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR-KEY-SECRET
# Razorpay Dashboard → Webhooks → secret for https://<domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# ---------------------------------------------------------------------------
# Mobile OTP / SMS delivery
# ---------------------------------------------------------------------------
# IMPORTANT — WHERE THE SMS CREDENTIALS ACTUALLY LIVE:
# This app NEVER sends an SMS itself and never holds an SMS gateway secret.
# The one-time code is generated and delivered by SUPABASE PHONE AUTH (GoTrue),
# so the provider credentials belong to the Supabase PROJECT:
#
#   Supabase Dashboard → Authentication → Sign In / Up → Phone
#     • enable "Enable Phone provider"
#     • choose the SMS provider and enter its credentials
#
# The equivalent GoTrue environment variables of that project (self-hosted
# Supabase: set them on the `auth`/GoTrue container, NOT here):
#   GOTRUE_EXTERNAL_PHONE_ENABLED=true
#   GOTRUE_SMS_PROVIDER=twilio            # or msg91 | textlocal | vonage | hook
#   GOTRUE_SMS_TWILIO_ACCOUNT_SID=...
#   GOTRUE_SMS_TWILIO_AUTH_TOKEN=...
#   GOTRUE_SMS_TWILIO_MESSAGE_SERVICE_SID=...
#   GOTRUE_SMS_MAX_FREQUENCY=60s
#   GOTRUE_SMS_OTP_EXP=600                # keep >= the 10-minute DB window
#   GOTRUE_SMS_TEMPLATE="Your Mali Vivah verification code is {{ .Code }}"
#
# Without that project-side configuration /api/mobile-otp/request answers
# 503 with a precise code (OTP_PHONE_DISABLED / OTP_SMS_NOT_CONFIGURED /
# OTP_SMS_TEST_PROVIDER) BEFORE any rate-limit budget is spent — it never
# claims a code was sent.
#
# The three variables below are OPTIONAL server-only CONTRACT checks consumed
# by src/lib/sms/otp-provider.ts. No NEXT_PUBLIC_ prefix: they never reach the
# browser bundle, and none of them is a credential.
#
# Provider this deployment expects the project to use. When set, the OTP route
# verifies the live project reports the same one and refuses a mismatch.
#SUPABASE_SMS_PROVIDER=twilio
# DLU-approved sender id / mask — recorded in server-side diagnostics only.
#SUPABASE_SMS_SENDER_ID=MALIVH
# LOCAL DEVELOPMENT ONLY. GoTrue's built-in `test` SMS provider accepts the
# send and delivers nothing, so by default the route refuses it. Set to `true`
# to let a local project proceed; the API then answers delivery:"simulated"
# and the UI says a test provider is in use — it never shows "OTP sent".
#MOBILE_OTP_ALLOW_TEST_PROVIDER=false

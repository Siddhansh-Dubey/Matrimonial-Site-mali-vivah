# Copy to .env.local and fill in your Supabase project values.
# NEVER commit .env.local (it is git-ignored). Service-role key stays server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (server-only — never expose the secret client-side).
# The browser only receives KEY_ID from /api/payments/order to open checkout.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR-KEY-SECRET
# Razorpay Dashboard → Webhooks → secret for https://<domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# MSG91 (optional, server-only) — sends the mobile-verification OTP by SMS.
# When unset, the app runs in dev mode: the code is logged server-side and
# returned as `devCode` (non-production only) so verification still works.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# DLT template id for India scrubbing (optional).
MSG91_DLT_TEMPLATE_ID=
